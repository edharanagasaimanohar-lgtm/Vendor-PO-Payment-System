# =========================================================================
# PAPER PLANE PROCUREMENT SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================
# Use this file as a template for configuring environment variables.
# For local development: Copy this file to a new file named `.env` and fill in the values.
# For production: Add these environment variables in your Render (Backend) and Vercel (Frontend) settings.

# -------------------------------------------------------------------------
# 1. Database Configurations (Aiven MySQL / Local MySQL)
# -------------------------------------------------------------------------
# The host address of your MySQL database server (e.g., Aiven host or localhost)
DB_HOST=localhost

# The port on which MySQL is listening (Default is 3306, Aiven is typically 14265 or similar)
DB_PORT=3306

# The database user name (e.g., root, or avnadmin for Aiven)
DB_USER=root

# The password associated with the database user
DB_PASSWORD=

# The name of the database schema (e.g., vendor_po_management)
DB_NAME=vendor_po_management

# Set to 'true' to enable SSL encryption (Highly recommended for cloud databases like Aiven)
DB_SSL=false


# -------------------------------------------------------------------------
# 2. Authentication Properties
# -------------------------------------------------------------------------
# Secret key used for signing and verifying JWT authentication tokens. Choose a long, secure random string.
JWT_SECRET=PaperPlaneKey_Secret2026!


# -------------------------------------------------------------------------
# 3. Production, CORS & API Communications Configurations
# -------------------------------------------------------------------------
# Defines the operating environment. Set to 'production' on Render/Vercel.
NODE_ENV=development

# Allowed Origins for CORS protection. List your deployed Vercel frontend URL here (separated by commas).
# E.g., CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Dynamic Backend Endpoint for Frontend routing. 
# Used by Vercel frontend to know where to find the Render backend API.
# E.g., VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
